{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "target": "ESNext",
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "skipLibCheck": true
  },
  "include": ["bgm/**/*.ts", "keys/**/*.ts", "ui/**/*.ts", "ui/**/*.tsx"]
}
